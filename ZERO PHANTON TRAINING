<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0d100e">
<title>Zero Phanton Training · 2.0</title>
<style>
:root{color-scheme:dark;--bg:#0d100e;--panel:#151b17;--panel2:#1b241e;--line:#29352d;--text:#f1f5f1;--muted:#9aa99d;--green:#8be0a1;--green2:#3c9b5a;--red:#f18b8b;--yellow:#e8ce7b}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse at 50% -20%,#1b3021 0%,var(--bg) 55%);color:var(--text);font:15px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
.wrap{max-width:850px;margin:auto;padding:18px 15px calc(86px + env(safe-area-inset-bottom))}
.top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:4px 0 20px}.eyebrow{font-size:11px;letter-spacing:.16em;color:var(--green);font-weight:800}.tag{border:1px solid var(--line);border-radius:99px;padding:5px 9px;color:var(--muted);font-size:11px}
h1{font-size:clamp(30px,7vw,43px);line-height:1.02;margin:8px 0;letter-spacing:-.05em}h2{font-size:18px;margin:0 0 5px;letter-spacing:-.02em}.sub,.muted{color:var(--muted)}.sub{margin:0}
.hero{background:linear-gradient(135deg,#19251d,#121814);border:1px solid var(--line);border-radius:21px;padding:20px;margin-bottom:18px}.hero-row{display:flex;justify-content:space-between;align-items:end;gap:10px}.big{font-size:32px;font-weight:850;letter-spacing:-.05em;color:var(--green)}.small{color:var(--muted);font-size:11px}.progress{height:7px;background:#27332b;border-radius:20px;overflow:hidden;margin-top:15px}.progress span{display:block;height:100%;width:0;background:var(--green);transition:width .2s}
.section-title{font-size:19px;margin:25px 0 11px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:11px}.card{background:var(--panel);border:1px solid var(--line);border-radius:17px;padding:16px;margin-bottom:11px}.block-head{display:flex;justify-content:space-between;align-items:start;gap:8px}.duration{font-size:11px;color:var(--green);font-weight:800;white-space:nowrap}.desc{font-size:13px;color:var(--muted);margin:5px 0 12px}
.tasks{display:grid;gap:9px;margin:12px 0}.task{display:flex;gap:10px;align-items:flex-start;font-size:13px;color:#dce5de}.task input{accent-color:var(--green);width:17px;height:17px;margin:2px 0 0;flex:none}.task.done span{text-decoration:line-through;color:#829087}
.timer{display:flex;align-items:center;justify-content:space-between;gap:10px;padding-top:12px;border-top:1px solid var(--line)}.time{font-variant-numeric:tabular-nums;font-size:24px;font-weight:800;letter-spacing:.03em}.buttons,.actions{display:flex;gap:7px;flex-wrap:wrap}
button{border:1px solid var(--line);background:var(--panel2);color:var(--text);padding:9px 12px;border-radius:10px;font-weight:700;font-size:12px;cursor:pointer}button.primary{background:var(--green);border-color:var(--green);color:#102015}button:active{transform:scale(.98)}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.stat{background:#101612;border:1px solid var(--line);border-radius:12px;padding:11px}.stat strong{display:block;font-size:22px}.stat span{font-size:10px;color:var(--muted)}
.field{display:grid;gap:5px;margin:10px 0}.field label{font-size:12px;color:var(--muted)}input[type=number],input[type=text],textarea,select{width:100%;background:#0f1511;border:1px solid var(--line);border-radius:10px;color:var(--text);padding:11px;font:inherit}textarea{min-height:75px;resize:vertical}
.brawlers{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}.brawler{border:1px solid var(--line);border-radius:13px;background:#101612;padding:12px}.brawler strong{display:block}.brawler small{color:var(--muted)}
.goal{display:flex;gap:10px;align-items:flex-start;padding:10px 0;border-bottom:1px solid var(--line)}.goal:last-child{border:0}.goal input{accent-color:var(--green);margin-top:3px}
.log{padding:10px 0;border-bottom:1px solid var(--line);font-size:13px}.log:last-child{border:0}
.notice{font-size:11px;color:var(--muted);margin-top:10px}.footer{text-align:center;color:#748178;font-size:11px;margin-top:22px}
.nav{position:fixed;z-index:5;bottom:0;left:0;right:0;background:#101612ee;backdrop-filter:blur(14px);border-top:1px solid var(--line);padding:8px 8px calc(8px + env(safe-area-inset-bottom));display:flex;justify-content:center;gap:4px}.nav a{color:var(--muted);text-decoration:none;text-align:center;font-size:10px;font-weight:700;flex:1;max-width:120px;padding:5px 2px;border-radius:9px}.nav a span{display:block;font-size:17px}
@media(max-width:600px){.grid{grid-template-columns:1fr}.hero{padding:17px}.timer{align-items:flex-start;flex-direction:column}.stats{grid-template-columns:repeat(2,1fr)}.brawlers{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>
<div class="wrap">
  <div class="top"><div class="eyebrow">ZERO PHANTON TRAINING · BRAWL STARS</div><div class="tag">VERSIÓN 2.0</div></div>
  <section class="hero" id="inicio">
    <div class="hero-row"><div><div class="eyebrow">TU OBJETIVO</div><h1>Zero<br>Phanton Training</h1><p class="sub">Entrena con intención. Juega con cabeza.</p></div><div style="text-align:right"><div class="big">95–100</div><div class="small">MIN / SESIÓN</div></div></div>
    <div class="progress"><span id="overall"></span></div><div class="small" id="progressText" style="margin-top:7px">0 de 5 bloques completados</div>
  </section>

  <h2 class="section-title" id="entreno">Tu entrenamiento</h2>
  <div class="grid">
    <section class="card block" data-block="warm">
      <div class="block-head"><div><h2>01 · Calentamiento</h2><div class="desc">Activa puntería, movimiento y posicionamiento.</div></div><div class="duration">20 MIN</div></div>
      <div class="tasks">
        <label class="task"><input type="checkbox"><span><b>5 min · Puntería:</b> apunta con calma y evita disparar por impulso.</span></label>
        <label class="task"><input type="checkbox"><span><b>5 min · Movimiento:</b> esquiva y cambia de dirección sin moverte sin sentido.</span></label>
        <label class="task"><input type="checkbox"><span><b>5 min · Posicionamiento:</b> aprovecha paredes y coberturas.</span></label>
        <label class="task"><input type="checkbox"><span><b>5 min · Decisiones:</b> practica avanzar, mantener posición o retroceder.</span></label>
      </div>
      <div class="timer"><div class="time" data-timer="1200">20:00</div><div class="buttons"><button class="primary start">Iniciar</button><button class="reset">Reiniciar</button></div></div>
    </section>
    <section class="card block" data-block="ladder">
      <div class="block-head"><div><h2>02 · Ladder</h2><div class="desc">Practica sin obsesionarte con los trofeos.</div></div><div class="duration">20–25 MIN</div></div>
      <div class="tasks">
        <label class="task"><input type="checkbox"><span>Adapta tu ritmo al mapa y al modo.</span></label>
        <label class="task"><input type="checkbox"><span>No persigas una eliminación si pierdes posición.</span></label>
        <label class="task"><input type="checkbox"><span>Identifica una decisión buena y otra mejorable.</span></label>
        <label class="task"><input type="checkbox"><span>Prioriza sobrevivir y ayudar al equipo.</span></label>
      </div>
      <div class="timer"><div class="time" data-timer="1200">20:00</div><div class="buttons"><button class="primary start">Iniciar</button><button class="reset">Reiniciar</button></div></div>
    </section>
    <section class="card block" data-block="ranked">
      <div class="block-head"><div><h2>03 · Competitivo</h2><div class="desc">Tu bloque principal: selección, mapa y decisiones.</div></div><div class="duration">40 MIN</div></div>
      <div class="tasks">
        <label class="task"><input type="checkbox"><span>Revisa mapa, modo y composición rival antes de elegir.</span></label>
        <label class="task"><input type="checkbox"><span>Escoge un Brawler que conozcas y encaje en el mapa.</span></label>
        <label class="task"><input type="checkbox"><span>No te adelantes solo: juega con la posición de tu equipo.</span></label>
        <label class="task"><input type="checkbox"><span>Decide cuándo atacar y cuándo retroceder.</span></label>
        <label class="task"><input type="checkbox"><span>Si te frustras o encadenas errores, haz una pausa.</span></label>
      </div>
      <div class="timer"><div class="time" data-timer="2400">40:00</div><div class="buttons"><button class="primary start">Iniciar</button><button class="reset">Reiniciar</button></div></div>
    </section>
    <section class="card block" data-block="review">
      <div class="block-head"><div><h2>04 · Análisis</h2><div class="desc">Aprende de tus decisiones, no solo del resultado.</div></div><div class="duration">10 MIN</div></div>
      <div class="tasks">
        <label class="task"><input type="checkbox"><span>Recuerda una muerte que podrías haber evitado.</span></label>
        <label class="task"><input type="checkbox"><span>Detecta si te adelantaste sin apoyo.</span></label>
        <label class="task"><input type="checkbox"><span>Piensa cuándo habría sido mejor retroceder.</span></label>
        <label class="task"><input type="checkbox"><span>Elige una mejora concreta para la próxima sesión.</span></label>
      </div>
      <div class="timer"><div class="time" data-timer="600">10:00</div><div class="buttons"><button class="primary start">Iniciar</button><button class="reset">Reiniciar</button></div></div>
    </section>
  </div>

  <section class="card block" data-block="goal">
    <div class="block-head"><div><h2>05 · Objetivo diario</h2><div class="desc">Cierra la sesión con una meta medible.</div></div><div class="duration">5 MIN</div></div>
    <div class="tasks">
      <label class="task"><input type="checkbox"><span>He elegido un aspecto concreto que mejorar.</span></label>
      <label class="task"><input type="checkbox"><span>He anotado mi objetivo para la siguiente sesión.</span></label>
    </div>
    <div class="timer"><div class="time" data-timer="300">05:00</div><div class="buttons"><button class="primary start">Iniciar</button><button class="reset">Reiniciar</button></div></div>
  </section>

  <h2 class="section-title" id="ejercicios">Ejercicios específicos</h2>
  <section class="card">
    <h2>Controla tus avances</h2><p class="desc">Dos ejercicios centrados en los errores que quieres corregir.</p>
    <div class="tasks">
      <label class="task"><input type="checkbox" class="exercise"><span><b>La regla de la cobertura:</b> antes de avanzar, comprueba dónde está tu equipo y qué cobertura tendrás al salir.</span></label>
      <label class="task"><input type="checkbox" class="exercise"><span><b>El segundo de pausa:</b> antes de atacar, pregúntate si tienes ventaja, apoyo y una salida segura.</span></label>
      <label class="task"><input type="checkbox" class="exercise"><span><b>Revisión de posición:</b> después de cada partida, identifica una ocasión en la que avanzar o retroceder habría sido mejor.</span></label>
    </div>
    <p class="notice">Marca cada ejercicio cuando lo hayas practicado. Se guarda en este dispositivo.</p>
  </section>

  <h2 class="section-title" id="brawlers">Tus Brawlers principales</h2>
  <section class="card">
    <div class="brawlers">
      <div class="brawler"><strong>Emz</strong><small>Control de zona y distancia</small></div>
      <div class="brawler"><strong>Sandy</strong><small>Apoyo, control y utilidad</small></div>
      <div class="brawler"><strong>Colette</strong><small>Presión contra objetivos con mucha vida</small></div>
      <div class="brawler"><strong>Squeak</strong><small>Control de espacio y anticipación</small></div>
    </div>
    <p class="notice">Elige según el mapa, el modo y la composición del equipo; no fuerces siempre el mismo Brawler.</p>
  </section>

  <h2 class="section-title" id="objetivos">Objetivos personales</h2>
  <section class="card">
    <div id="goalList">
      <label class="goal"><input type="checkbox" class="goalcheck"><span>No adelantarme sin tener apoyo del equipo.</span></label>
      <label class="goal"><input type="checkbox" class="goalcheck"><span>Reconocer cuándo tengo que retroceder.</span></label>
      <label class="goal"><input type="checkbox" class="goalcheck"><span>Elegir el Brawler pensando en el mapa y el modo.</span></label>
      <label class="goal"><input type="checkbox" class="goalcheck"><span>Revisar mis decisiones después de jugar.</span></label>
    </div>
    <div class="field"><label for="customGoal">Añadir un objetivo propio</label><input id="customGoal" type="text" maxlength="90" placeholder="Ej.: controlar mejor el centro del mapa"></div>
    <div class="actions"><button class="primary" id="addGoal">Añadir objetivo</button></div>
  </section>

  <h2 class="section-title" id="estadisticas">Estadísticas</h2>
  <section class="card">
    <div class="stats">
      <div class="stat"><strong id="sessions">0</strong><span>SESIONES</span></div>
      <div class="stat"><strong id="wins">0</strong><span>VICTORIAS</span></div>
      <div class="stat"><strong id="losses">0</strong><span>DERROTAS</span></div>
      <div class="stat"><strong id="rate">0%</strong><span>VICTORIAS</span></div>
    </div>
    <div class="grid" style="margin-top:12px">
      <div class="field"><label for="winInput">Victorias de hoy</label><input id="winInput" type="number" min="0" step="1" value="0"></div>
      <div class="field"><label for="lossInput">Derrotas de hoy</label><input id="lossInput" type="number" min="0" step="1" value="0"></div>
    </div>
    <div class="field"><label for="mistake">¿Qué error has cometido más?</label><select id="mistake"><option value="">Selecciona una opción</option><option>Me he adelantado demasiado</option><option>No sabía cuándo atacar o retroceder</option><option>Mal posicionamiento</option><option>He gastado mal mis recursos</option><option>He elegido mal el Brawler</option><option>Otro</option></select></div>
    <div class="field"><label for="notes">Aprendizaje de hoy</label><textarea id="notes" placeholder="¿Qué has aprendido en esta sesión?"></textarea></div>
    <div class="field"><label for="nextGoal">Objetivo para la próxima sesión</label><input id="nextGoal" type="text" placeholder="Ej.: no entrar solo en los enfrentamientos"></div>
    <div class="actions"><button class="primary" id="save">Guardar sesión</button><button id="clearDay">Limpiar formulario</button></div>
    <p class="notice" id="saveMsg" aria-live="polite">Tus datos se guardan en este dispositivo y navegador.</p>
    <h2 style="margin-top:18px">Últimas sesiones</h2><div id="history"><p class="notice">Todavía no hay sesiones guardadas.</p></div>
  </section>
  <div class="footer">ZERO PHANTON TRAINING · CONSTANCIA &gt; JUGAR POR JUGAR</div>
</div>
<nav class="nav"><a href="#inicio"><span>⌂</span>Inicio</a><a href="#entreno"><span>◷</span>Rutina</a><a href="#ejercicios"><span>◎</span>Ejercicios</a><a href="#brawlers"><span>✦</span>Brawlers</a><a href="#estadisticas"><span>▥</span>Stats</a></nav>
<script>
(()=>{
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const KEY='roadToLeyendaV2';
let data={sessions:0,wins:0,losses:0,checks:{},logs:[],exercises:{},goals:{}};
try{data={...data,...JSON.parse(localStorage.getItem(KEY)||'{}')}}catch(e){}
const persist=()=>{try{localStorage.setItem(KEY,JSON.stringify(data))}catch(e){$('#saveMsg').textContent='No se pudieron guardar los datos en este navegador.'}};
function updateStats(){
 $('#sessions').textContent=data.sessions||0;$('#wins').textContent=data.wins||0;$('#losses').textContent=data.losses||0;
 const total=(data.wins||0)+(data.losses||0);$('#rate').textContent=(total?Math.round(data.wins/total*100):0)+'%';
}
function updateProgress(){
 const blocks=$$('.block[data-block]');let done=0;
 blocks.forEach(b=>{const checks=$$('input[type=checkbox]',b);if(checks.length&&checks.every(c=>c.checked))done++});
 $('#overall').style.width=(done/blocks.length*100)+'%';$('#progressText').textContent=done+' de '+blocks.length+' bloques completados';
}
$$('.block[data-block]').forEach(b=>{
 const id=b.dataset.block;
 $$('input[type=checkbox]',b).forEach((c,i)=>{
  const key=id+'-'+i;c.checked=!!data.checks?.[key];c.closest('.task')?.classList.toggle('done',c.checked);
  c.addEventListener('change',()=>{data.checks=data.checks||{};data.checks[key]=c.checked;c.closest('.task')?.classList.toggle('done',c.checked);persist();updateProgress()});
 });
});
$$('.exercise').forEach((c,i)=>{c.checked=!!data.exercises?.[i];c.addEventListener('change',()=>{data.exercises=data.exercises||{};data.exercises[i]=c.checked;persist()})});
function renderGoals(){
 const list=$('#goalList');list.querySelectorAll('.goal.custom').forEach(n=>n.remove());
 (data.customGoals||[]).forEach((g,i)=>{
  const label=document.createElement('label');label.className='goal custom';
  const input=document.createElement('input');input.type='checkbox';input.className='goalcheck';input.checked=!!data.goals?.['custom-'+i];
  const span=document.createElement('span');span.textContent=g;
  input.addEventListener('change',()=>{data.goals=data.goals||{};data.goals['custom-'+i]=input.checked;persist()});
  label.append(input,span);list.append(label);
 });
 $$('.goalcheck:not(.custom input)').forEach((c,i)=>{c.checked=!!data.goals?.['base-'+i];c.onchange=()=>{data.goals=data.goals||{};data.goals['base-'+i]=c.checked;persist()}});
}
$('#addGoal').addEventListener('click',()=>{
 const value=$('#customGoal').value.trim();if(!value)return;
 data.customGoals=data.customGoals||[];data.customGoals.push(value);$('#customGoal').value='';persist();renderGoals();
});
function renderHistory(){
 const host=$('#history');host.innerHTML='';
 const logs=(data.logs||[]).slice(-5).reverse();
 if(!logs.length){host.innerHTML='<p class="notice">Todavía no hay sesiones guardadas.</p>';return}
 logs.forEach(log=>{
  const div=document.createElement('div');div.className='log';
  const title=document.createElement('b');title.textContent=log.date+' · '+log.wins+'V / '+log.losses+'D';
  div.append(title);
  if(log.mistake){const p=document.createElement('div');p.className='muted';p.textContent='Error: '+log.mistake;div.append(p)}
  if(log.goal){const p=document.createElement('div');p.className='muted';p.textContent='Próximo objetivo: '+log.goal;div.append(p)}
  host.append(div);
 });
}
updateStats();updateProgress();renderGoals();renderHistory();
$$('.block[data-block]').forEach(b=>{
 const display=$('[data-timer]',b),start=$('.start',b),reset=$('.reset',b);
 const initial=Number(display.dataset.timer);let remaining=initial,interval=null,endAt=0;
 function render(){const n=Math.max(0,remaining);display.textContent=String(Math.floor(n/60)).padStart(2,'0')+':'+String(n%60).padStart(2,'0')}
 function pause(){if(interval)clearInterval(interval);interval=null;remaining=Math.max(0,Math.ceil((endAt-Date.now())/1000));render();start.textContent='Continuar'}
 start.addEventListener('click',()=>{
  if(interval){pause();return}
  if(remaining<=0)remaining=initial;
  endAt=Date.now()+remaining*1000;start.textContent='Pausar';
  interval=setInterval(()=>{
   remaining=Math.max(0,Math.ceil((endAt-Date.now())/1000));render();
   if(remaining<=0){clearInterval(interval);interval=null;start.textContent='Reiniciar';display.textContent='¡Completado!';}
  },250);
 });
 reset.addEventListener('click',()=>{if(interval)clearInterval(interval);interval=null;remaining=initial;render();start.textContent='Iniciar'});
});
$('#save').addEventListener('click',()=>{
 const w=Math.max(0,parseInt($('#winInput').value)||0),l=Math.max(0,parseInt($('#lossInput').value)||0);
 if(w+l===0&&!$('#notes').value.trim()&&!$('#nextGoal').value.trim()){ $('#saveMsg').textContent='Añade resultados o una nota antes de guardar.';return}
 data.sessions=(data.sessions||0)+1;data.wins=(data.wins||0)+w;data.losses=(data.losses||0)+l;
 data.logs=data.logs||[];data.logs.push({date:new Date().toLocaleDateString('es-ES'),wins:w,losses:l,mistake:$('#mistake').value,notes:$('#notes').value,goal:$('#nextGoal').value});
 persist();updateStats();renderHistory();$('#winInput').value=0;$('#lossInput').value=0;$('#mistake').value='';$('#notes').value='';$('#nextGoal').value='';$('#saveMsg').textContent='Sesión guardada. ¡Buen trabajo!';
});
$('#clearDay').addEventListener('click',()=>{$('#winInput').value=0;$('#lossInput').value=0;$('#mistake').value='';$('#notes').value='';$('#nextGoal').value='';$('#saveMsg').textContent='Formulario limpio.'});
})();
</script>
</body>
</html>
